rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para obtener datos del usuario actual
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Función auxiliar para verificar si es ADMIN
    function isAdmin() {
      // Nota: Si el usuario no existe en la colección, lanza error (evalúa a false)
      return request.auth != null && getUserData().role == 'admin';
    }
    
    // Función auxiliar para verificar si es JUEZ
    function isJudge() {
      return request.auth != null && getUserData().role == 'judge';
    }

    // Regla base de seguridad: Denegar por defecto
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Colección de usuarios (users)
    match /users/{userId} {
      // El admin puede leer y crear/eliminar usuarios
      // Cualquier usuario logueado (incluido el juez) puede leer *su propio* documento
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    // 2. Colección de obras (works)
    match /works/{workId} {
      // Admin y Jueces pueden leer el catálogo de obras
      allow read: if isAdmin() || isJudge();
      
      // SOLO el administrador puede crear, actualizar o eliminar obras
      allow write: if isAdmin();
    }

    // 3. Colección de calificaciones (scores)
    match /scores/{scoreId} {
      // Admin puede leer todos. Jueces solo pueden leer LOS SUYOS.
      allow read: if isAdmin() || (isJudge() && resource.data.judgeId == request.auth.uid);
      
      // Crear puntuación: 
      // 1. Debe ser juez.
      // 2. El judgeId especificado en el payload DEBE ser el mismo de su sesión (Previene suplantación).
      // ADMIN: Permitido temporalmente para generar calificaciones de prueba.
      allow create: if (isJudge() && request.resource.data.judgeId == request.auth.uid) || isAdmin();
      
      // Actualizar puntuación:
      // Solo el autor original (juez) puede modificar su nota, y el judgeId no puede mutar.
      allow update: if isJudge() 
                    && resource.data.judgeId == request.auth.uid 
                    && request.resource.data.judgeId == resource.data.judgeId;
                    
      // Solo el admin podría borrar un puntaje (ej: si borran un juez, por cascada, aunque por ahora no es requerido, se bloquea al juez)
      allow delete: if isAdmin();
    }

  }
}
